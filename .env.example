# ReplyOps AI environment example. Values are placeholders only.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REPLYOPS_WEBCHAT_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://replyops_user:change-me@localhost:5433/replyops_app

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-local-secret-at-least-32-characters
REPLYOPS_OWNER_EMAIL=owner@example.com
REPLYOPS_OWNER_BOOTSTRAP_PASSWORD=change-me-temporary-owner-password
REPLYOPS_OWNER_CURRENT_PASSWORD=change-me-current-owner-password

# Encryption
REPLYOPS_CREDENTIALS_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Gemini
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_BASE_URL=http://localhost:3000

# WhatsApp
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
WHATSAPP_VERIFY_TOKEN=change-me-provider-verify-token

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
N8N_ENCRYPTION_KEY=change-me-existing-n8n-encryption-key
REPLYOPS_N8N_V4_WEBHOOK_URL=http://localhost:5678/webhook/replyops/v4/runtime

# Internal HMAC
REPLYOPS_INTERNAL_HMAC_SECRET=change-me-hmac-secret
REPLYOPS_INTERNAL_HMAC_KEY_ID=local-key

# Deployment
REPLYOPS_APP_PORT=3111
REPLYOPS_PRECHECK_PORT=3112
REPLYOPS_UPLOADS_DIR=./uploads

# Optional features
REPLYOPS_AUTH_DEBUG=false
